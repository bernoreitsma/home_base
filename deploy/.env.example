# Production environment for the homeserver deploy.
# Copy to deploy/.env and replace every secret before deploying.

# --- Django ---
# Generate a fresh one, e.g.:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=replace-with-a-long-random-secret

# Production runs with debug OFF. Leave this as-is.
DJANGO_DEBUG=False

# Hostnames/IPs this server answers on (comma-separated), e.g.
# "homeserver.local,192.168.1.10". Required when DEBUG is off.
DJANGO_ALLOWED_HOSTS=homeserver.local

# Only needed when serving over https or behind a reverse proxy, e.g.
# "https://home.example.com". Comma-separated; leave blank for plain LAN http.
DJANGO_CSRF_TRUSTED_ORIGINS=

# Number of gunicorn worker processes (optional; defaults to 3).
GUNICORN_WORKERS=3

# --- Postgres ---
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=home_base
POSTGRES_USER=home_base
POSTGRES_PASSWORD=replace-with-a-strong-password
